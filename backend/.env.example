# PostgreSQL — the local cluster runs on PORT 5433 (not 5432)
# Copy this file to backend/.env and fill in real values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/kanban"
# Test database (used by `npm test`); keep it separate from dev data
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5433/kanban_test"

# Auth — generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000

# Origin allowed to call the API (CORS for fetch + socket.io handshake).
CLIENT_ORIGIN="http://localhost:5173"

# Auth cookie SameSite: "lax" (default) for same-site deploys — localhost, or
# app.example.com + api.example.com. Use "none" when the frontend and the API
# are on DIFFERENT sites, which is the case for two separate Render services:
# app.onrender.com and api.onrender.com are cross-site because onrender.com is
# on the Public Suffix List, so a lax cookie would never be sent back.
# "none" requires Secure (HTTPS) — Render provides that automatically.
# When you set it, also point CLIENT_ORIGIN and PUBLIC_URL at the frontend.
#   CLIENT_ORIGIN="https://your-frontend.onrender.com"
#   PUBLIC_URL="https://your-frontend.onrender.com"
#   COOKIE_SAMESITE="none"
COOKIE_SAMESITE="lax"

# ── Outbound email (invitations) ─────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email — invite links still work, you just
# have to copy/paste them yourself. Fill these in to email invite links.
SMTP_HOST=""                 # e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.resend.com
SMTP_PORT=587                # 587 = STARTTLS, 465 = implicit TLS
SMTP_SECURE=false            # "true" only for port 465
SMTP_USER=""                 # account / API key user
SMTP_PASS=""                 # password / API key (Gmail: use an App Password)
SMTP_FROM=""                 # optional, e.g. "My App <no-reply@example.com>"
                            # defaults to: "<APP_NAME> <SMTP_USER>"

# Links put in emails and other outbound messages.
# Public URL of the FRONTEND (where /invite/:code resolves).
PUBLIC_URL="http://localhost:5173"
APP_NAME="Kanban"

# ── Redis — OTP codes shared across instances ────────────────────────────────
# Empty = in-process store (local dev / single instance).
# Render Redis gives you something like: redis://red-xxxxxxxx:6379
REDIS_URL=""

# ── One-time codes (email verification + password reset) ─────────────────────
OTP_TTL_SECONDS=600            # code lifetime
OTP_MAX_ATTEMPTS=5             # wrong guesses before the code is destroyed
OTP_MAX_SENDS=3                # codes per address per window
OTP_SEND_WINDOW_SECONDS=900
